# HingeLab environment variables. Copy to .env.local for development; set the same names in Vercel.
# Variables starting with NEXT_PUBLIC_ are sent to the browser. Everything else stays on the server.
# Leave the Supabase values empty to run in guest mode (editor only, saved in the browser).

# Public URL of the site, used in emails, Stripe return links, canonical URLs, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Contact address shown on the Terms and Privacy pages.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional: where the browser loads the photo depth model (Depth-Anything-V2-Small ONNX, Apache-2.0).
# Empty = /models/depth-anything-v2-small/model_quantized.onnx (`npm run fetch:depth-model`), then Hugging Face.
NEXT_PUBLIC_DEPTH_MODEL_URL=

# --- Supabase (Settings > API in the dashboard; `npx supabase status` for the local stack) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the Stripe webhook to update plans. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google sign-in (read by `npx supabase start` for the local stack; set in the dashboard for production) ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- AI designer (server only) ---
# On Vercel it uses the AI Gateway with no key. Default order is Claude, then OpenAI, then the
# gateway's OpenAI chain. AI_DESIGN_ORDER=openai,gateway restores the previous order (restart only).
# AI_CLAUDE_MODEL defaults to anthropic/claude-sonnet-5-5. ANTHROPIC_MODEL is the direct model id.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_GATEWAY_API_KEY=
AI_DESIGN_MODEL=
AI_DESIGN_ORDER=
AI_CLAUDE_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# POST /api/svg: designs per signed-in user per day, and the bed the SVG must fit (mm).
SVG_DAILY_LIMIT=10
SVG_BED_W=900
SVG_BED_H=600

# --- Stripe (TEST mode keys only: sk_test_..., whsec_...) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Original Pro prices ($9/month, $79/year). Leave these Stripe prices unchanged.
# Existing subscribers stay on them. New checkouts do not use them.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# New prices. Create them in Stripe; do not edit the $9/$79 prices above.
# Pro: $12/month, $99/year. Business: $29/month, $290/year. Founder Lifetime: $179 once.
PRICE_PRO_MONTHLY=
PRICE_PRO_YEARLY=
PRICE_BUSINESS_MONTHLY=
PRICE_BUSINESS_YEARLY=
PRICE_LIFETIME=
# Safety switch: the server refuses sk_live_ keys unless this is exactly "true". Set it only at launch.
STRIPE_ALLOW_LIVE=false
