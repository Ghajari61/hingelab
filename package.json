{
  "name": "hingelab",
  "private": true,
  "sideEffects": [
    "*.css",
    "./components/ui/index.ts",
    "./desktop/src/harden.ts"
  ],
  "scripts": {
    "predev": "node scripts/copy-wasm.js",
    "dev": "next dev",
    "prebuild": "node scripts/copy-wasm.js && node scripts/licenses.mjs",
    "licenses": "node scripts/licenses.mjs",
    "build": "next build",
    "postinstall": "node scripts/copy-wasm.js",
    "start": "next start",
    "fetch:depth-model": "node scripts/fetch-depth-model.mjs",
    "build:shape-icons": "vite-node -c vitest.config.ts scripts/shape-icons.ts",
    "perf:budgets": "node scripts/perf/budgets.mjs",
    "perf:preview": "node scripts/perf/preview.mjs",
    "test": "vitest run",
    "desktop:ui:dev": "vite --config desktop/vite.config.ts",
    "desktop:ui:build": "vite build --config desktop/vite.config.ts",
    "desktop:dev": "cd desktop && tauri dev",
    "desktop:build": "node scripts/licenses.mjs --cargo && node scripts/desktop/build.mjs",
    "desktop:test": "cd desktop/src-tauri && cargo test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.81",
    "@ai-sdk/openai": "4.0.92",
    "@anthropic-ai/sdk": "^0.135.0",
    "@resvg/resvg-js": "2.6.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "ai": "^7.0.138",
    "clipper-lib": "^6.4.2",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "harfbuzzjs": "^1.6.3",
    "immer": "^11.1.21",
    "lucide-react": "^1.55.0",
    "manifold-3d": "^3.5.4",
    "mathjs": "^15.2.0",
    "meshoptimizer": "^1.3.0",
    "next": "^15.5.4",
    "onnxruntime-web": "^1.30.0",
    "opentype.js": "^2.0.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "sharp": "file:vendor/sharp-stub",
    "stripe": "^23.0.0",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.1",
    "@tauri-apps/cli": "^2.12.2",
    "@types/clipper-lib": "^6.4.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "jsqr": "^1.4.0",
    "playwright": "^1.64.0",
    "storybook": "^10.6.1",
    "typescript": "^5.9.2",
    "vite": "^7.3.7",
    "vite-node": "^5.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.29",
    "sharp": "$sharp"
  }
}
