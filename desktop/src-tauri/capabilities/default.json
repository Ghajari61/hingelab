{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The app's own UI (the \"main\" webview only, never the \"web\" view that shows the website): its own commands, the signed updater and restart after an update. No file system, shell or HTTP access from JavaScript.",
  "webviews": ["main"],
  "permissions": [
    "core:app:allow-version",
    "core:event:default",
    "core:window:allow-set-title",
    "updater:default",
    "process:allow-restart",
    "allow-app-info",
    "allow-sign-in",
    "allow-cancel-sign-in",
    "allow-sign-out",
    "allow-me",
    "allow-reveal-file",
    "allow-open-web",
    "allow-get-prefs",
    "allow-choose-export-folder",
    "allow-set-export-prefs",
    "allow-choose-project-folder",
    "allow-set-project-prefs",
    "allow-web-open-file",
    "allow-recent-projects",
    "allow-forget-recent",
    "allow-take-open-request",
    "allow-web-open",
    "allow-web-bounds",
    "allow-web-hide",
    "allow-web-action",
    "allow-api-request",
    "allow-save-file",
    "allow-open-file",
    "allow-open-external",
    "allow-app-ready",
    "allow-splash-progress"
  ]
}
