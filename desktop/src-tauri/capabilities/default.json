{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The app's own UI (the \"main\" webview only, never the \"web\" view that shows the website): its own commands, the signed updater and restart after an update. No file system, shell or HTTP access from JavaScript.",
  "webviews": ["main"],
  "permissions": [
    "core:app:allow-version",
    "core:event:default",
    "core:window:allow-set-title",
    "updater:default",
    "process:allow-restart",
    "allow-app-info",
    "allow-sign-in",
    "allow-cancel-sign-in",
    "allow-sign-out",
    "allow-me",
    "allow-catalog",
    "allow-generate",
    "allow-ai-design",
    "allow-keep-svg",
    "allow-save-design",
    "allow-export-design",
    "allow-reveal-file",
    "allow-open-web",
    "allow-get-prefs",
    "allow-choose-export-folder",
    "allow-set-export-prefs",
    "allow-web-open",
    "allow-web-bounds",
    "allow-web-hide",
    "allow-web-action"
  ]
}
