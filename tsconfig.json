{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@hingelab/platform": [
        "./packages/platform/src/index.ts"
      ],
      "@hingelab/platform/*": [
        "./packages/platform/src/*"
      ],
      "@hingelab/app": [
        "./packages/app/src/index.ts"
      ],
      "@hingelab/app/*": [
        "./packages/app/src/*"
      ],
      "@hingelab/ui": [
        "./packages/ui/src/index.ts"
      ],
      "@hingelab/ui/*": [
        "./packages/ui/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-build/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "desktop/dist",
    "desktop/src-tauri",
    "tmp"
  ]
}
